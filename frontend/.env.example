# API backend URL (used by Next.js rewrites to proxy /api/*).
# Local dev: leave unset to use http://localhost:8000
# Vercel: set to your deployed backend URL, e.g. https://your-app.onrender.com
# API_URL=https://your-backend-url.com

# Optional: remote MP3 URLs for ChatWidget “Shopping vibe” background music (Chill / Energetic / Calm).
# Leave unset to use built-in demo URLs (SoundHelix examples). Use your own CDN in production.
# NEXT_PUBLIC_SHOPPING_VIBE_CHILL_URL=https://cdn.example.com/audio/chill-loop.mp3
# NEXT_PUBLIC_SHOPPING_VIBE_ENERGETIC_URL=https://cdn.example.com/audio/energetic-loop.mp3
# NEXT_PUBLIC_SHOPPING_VIBE_CALM_URL=https://cdn.example.com/audio/calm-loop.mp3
